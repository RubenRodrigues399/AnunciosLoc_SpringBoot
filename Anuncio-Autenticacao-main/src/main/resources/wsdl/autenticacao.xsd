<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://ws.anuncios.com/autenticacao"
    xmlns:tns="http://ws.anuncios.com/autenticacao"
    elementFormDefault="qualified">


    <!-- ====================================== -->
    <!--           REGISTO UTILIZADOR           -->
    <!-- ====================================== -->

    <!-- REQUEST: REGISTAR UTILIZADOR -->
    <xs:element name="RegistarUtilizadorRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nome" type="xs:string"/>
                <xs:element name="email" type="xs:string"/>
                <xs:element name="role" type="xs:string"/>
                <xs:element name="senha" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <!-- UTILIZADOR CLIENT REGISTO -->
    <xs:complexType name="UtilizadorRegisto">
        <xs:sequence>
            <xs:element name="uuid" type="xs:string"/>
            <xs:element name="nome" type="xs:string"/>
            <xs:element name="email" type="xs:string"/>
            <xs:element name="telefone" type="xs:string"/>
            <xs:element name="saldo" type="xs:int"/>
            <xs:element name="role" type="xs:string"/>
            <xs:element name="idPerfilActivo" type="xs:int"/>
            <xs:element name="nomePerfilActivo" type="xs:string"/>
            <xs:element name="dataCriacao" type="xs:string"/>
            <xs:element name="dataActualizacao" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>



    <!-- RESPONSE: REGISTAR UTILIZADOR [RESPONSE BASE + UTILIZADOR RESPONSE REGISTO ]-->    
    <xs:element name="RegistarUtilizadorResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="statusCode" type="xs:int"/>
                <xs:element name="mensagem" type="xs:string"/>
                <xs:element name="dados"    type="tns:UtilizadorRegisto"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <!-- ====================================== -->
    <!--                    LOGIN               -->
    <!-- ====================================== -->

    <xs:element name="LoginRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="email" type="xs:string"/>
                <xs:element name="senha" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="UtilizadorLogin">
        <xs:sequence>
            <xs:element name="uuid" type="xs:string"/>
            <xs:element name="nome" type="xs:string"/>
            <xs:element name="email" type="xs:string"/>
            <xs:element name="telefone" type="xs:string"/>
            <xs:element name="saldo" type="xs:int"/>
            <xs:element name="role" type="xs:string"/>
            <xs:element name="idPerfilActivo" type="xs:int"/>
            <xs:element name="nomePerfilActivo" type="xs:string"/>
            <xs:element name="token" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- RESPONSE: REGISTAR UTILIZADOR [RESPONSE BASE + UTILIZADOR RESPONSE REGISTO ]-->    
    <xs:element name="LoginResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="statusCode" type="xs:int"/>
                <xs:element name="mensagem" type="xs:string"/>
                <xs:element name="dados"    type="tns:UtilizadorLogin"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ====================================== -->
    <!--                    LOGOUT               -->
    <!-- ====================================== -->
    <xs:element name="LogoutRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="uuid" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="LogoutResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="statusCode" type="xs:int"/>
                <xs:element name="mensagem" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ====================================== -->
    <!--     ACTUALIZAR UTILIZADOR              -->
    <!-- ====================================== -->
    <xs:element name="UpdateRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="uuid" type="xs:string"/>
                <xs:element name="nome" type="xs:string"/>
                <xs:element name="email" type="xs:string"/>
                <xs:element name="telefone" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="UpdateResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="statusCode" type="xs:int"/>
                <xs:element name="mensagem" type="xs:string"/>
                <xs:element name="dados"    type="tns:UtilizadorRegisto"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ====================================== -->
    <!--    VERIFICAR A VALIDADE DO TICKET      -->
    <!-- ====================================== -->

    <xs:element name="ValidarTicketRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ticket" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="UtilizadorTicket">
        <xs:sequence>
            <xs:element name="uuid" type="xs:string"/>
            <xs:element name="nome" type="xs:string"/>
            <xs:element name="saldo" type="xs:int"/>
            <xs:element name="role" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="ValidarTicketResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="statusCode" type="xs:int"/>
                <xs:element name="mensagem" type="xs:string"/>
                <xs:element name="dados"    type="tns:UtilizadorTicket"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <!-- ====================================== -->
    <!--            REPLICAÇÃO                 -->
    <!-- ====================================== -->
    
    <xs:element name="ReplicacaoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="statusCode" type="xs:int"/>
                <xs:element name="mensagem" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- ====================================== -->
    <!--            REGISTRAR UTILIZADOR        -->
    <!-- ====================================== -->
    <xs:complexType name="UtilizadorRegistoReplicacaoRequest">
        <xs:sequence>
            <xs:element name="uuid" type="xs:string"/>
            <xs:element name="nome" type="xs:string"/>
            <xs:element name="email" type="xs:string"/>
            <xs:element name="telefone" type="xs:string"/>
            <xs:element name="saldo" type="xs:int"/>
            <xs:element name="role" type="xs:string"/>
            <xs:element name="idPerfilActivo" type="xs:int"/>
            <xs:element name="nomePerfilActivo" type="xs:string"/>
            <xs:element name="dataCriacao" type="xs:string"/>
            <xs:element name="dataActualizacao" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>


    <!-- ====================================== -->
    <!--            ACTUALIZAR UTILIZADOR        -->
    <!-- ====================================== -->
    <xs:complexType name="ActualizacaoUtilizadorReplicacaoRequest">
        <xs:sequence>
            <xs:element name="uuid" type="xs:string"/>
            <xs:element name="nome" type="xs:string"/>
            <xs:element name="email" type="xs:string"/>
            <xs:element name="telefone" type="xs:string"/>
            <xs:element name="saldo" type="xs:int"/>
            <xs:element name="idPerfilActivo" type="xs:int"/>
            <xs:element name="nomePerfilActivo" type="xs:string"/>
            <xs:element name="dataActualizacao" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

<xs:element name="ActualizacaoUtilizadorReplicacaoRequest"
            type="tns:ActualizacaoUtilizadorReplicacaoRequest"/>

    <!-- REQUEST: REGISTAR LOCAL -->
    <xs:element name="RegistarLocalRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nome" type="xs:string"/>
                <xs:element name="latitude" type="xs:double"/>
                <xs:element name="longitude" type="xs:double"/>
                <xs:element name="raio" type="xs:double"/>
                <xs:element name="url" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="LocalRegisto">
        <xs:sequence>
                <xs:element name="id" type="xs:int"/>
                <xs:element name="nome" type="xs:string"/>
                <xs:element name="latitude" type="xs:double"/>
                <xs:element name="longitude" type="xs:double"/>
                <xs:element name="raio" type="xs:double"/>
                <xs:element name="url" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PerfilRegisto">
        <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="titulo" type="xs:string"/>
            <xs:element name="dataCriacao" type="xs:string"/>
            <xs:element name="uuidUtilizadorCriador" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>


</xs:schema>
